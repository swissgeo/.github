{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "extends": [
    // https://docs.renovatebot.com/presets-config/#configrecommended
    "config:recommended",
    // https://docs.renovatebot.com/presets-group/#groupallnonmajor
    "group:allNonMajor",
    // https://docs.renovatebot.com/presets-default/#prconcurrentlimit10
    ":prConcurrentLimit10",
    // override semantic commit type to "chore" for all dependencies
    // default is "fix" for dependencies, "chore" for devDependencies
    ":semanticCommitTypeAll(chore)"
  ],
  "minimumReleaseAge": "2d",
  "semanticCommits": "enabled"
}
